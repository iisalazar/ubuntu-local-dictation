{
  "name": "local-dictation",
  "version": "1.0.0",
  "description": "Local-first dictation app — transcribe speech on-device with Whisper",
  "license": "MIT",
  "main": "src/main.js",
  "repository": "https://github.com/iisalazar/ubuntu-local-dictation",
  "scripts": {
    "start": "npm run build:renderer && electron --no-sandbox .",
    "dev": "concurrently \"vite --host\" \"sleep 2 && electron --no-sandbox . --dev\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:win": "npm run build:renderer && electron-builder --win",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "build": {
    "appId": "com.local-dictation.app",
    "productName": "Local Dictation",
    "files": [
      "src/main.js",
      "src/utils.js",
      "src/transcriber.mjs",
      "dist-renderer/**/*",
      "config.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "openai": "^4.80.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^28.1.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
